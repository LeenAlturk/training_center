<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_training_course_list" model="ir.ui.view">
    <field name="name">training.course.list</field>
    <field name="model">training.course</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="description"/>
            <field name="price"/>
            <field name="start_date"/>
            <field name="end_date"/>
            <field name="state"/>
            <field name="instructor_id"/>
            <field name="course_Number"/>
            <field name="tags_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
        </list>
    </field>
    </record>

     <record id="view_training_course_form" model="ir.ui.view">
     <field name="name">training.course.form</field>
    <field name="model">training.course</field>
    <field name="arch" type="xml">
        <form>
            <header>
                <field name="state" widget="statusbar"/>
                <button name="action_confirm_course" string="confirm" type="object" class="btn-primary"  />
                <button name="action_make_done_course" string="done" type="object" class="btn-primary"/>
                <button name="action_cancel_course" string="cancel" type="object" class="btn-secondary"/>
            </header>
            <sheet>
                 <div class="oe_button_box" name="button_box">
    <button name="action_see_related_product"
            type="object"
            class="oe_stat_button"
            icon="fa-cube">
        <div class="o_stat_info">
            <span class="o_stat_text">Product</span>
        </div>
    </button>
</div>
            <group string ="All info">
                    <field name="course_Number"/>
                    <field name="name" string ="Course Name"/>
                    <field name="description" string ="description"/>
                    <field name="price" string ="price"/>
                    <field name="seats" string="seats"/>
                    <field name="tags_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <field name="total_revenue" string="total Revenue"/>
           </group>
                <group string="other info">
                    <field name="start_date" string ="start date"/>
                    <field name="end_date" string="end date"/>
                    <field name="instructor_id" string="instructor"/>
                    <field name="email_instructor" string="Instructor Email"/>
                </group>
                <chatter/>
            </sheet>

        </form>
    </field>
    </record>

    <record id="view_training_course_search" model="ir.ui.view">
        <field name="name">training.course.search</field>
        <field name="model">training.course</field>
        <field name="arch" type="xml">
            <search>
                    <field name="course_Number"/>
                    <field name="name" string ="Course Name"/>
                    <field name="description" string ="description"/>
                    <field name="price" string ="price"/>
                    <field name="seats" string="seats"/>

                     <filter name="confirmed_satus" string="confirmed satus" domain="[('state','=','confirmed')]"/>

                    <group>
                        <filter name="group_by_satus" string="satus" context="{'group_by':'state'}"/>
                    </group>

            </search>
        </field>
    </record>


    <record id="action_training_course" model="ir.actions.act_window">
        <field name="name">course</field>
        <field name="res_model">training.course</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="action_confirm_courses" model="ir.actions.server">
    <field name="name">Confirm</field>
    <field name="model_id" ref="model_training_course"/>
    <field name="binding_model_id" ref="model_training_course"/>
    <field name="binding_view_types">list,form</field>
    <field name="state">code</field>
    <field name="code">records.action_confirm_course()</field>
    </record>


    <menuitem
            id="menu_training_center_root"
            name="training center"
            sequence="10"
    />
      <menuitem
            id="menu_training_corse"
            name="training course"
            action="action_training_course"
            parent="menu_training_center_root"
            sequence="0"
    />

</odoo>