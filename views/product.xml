<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_inhiret_view_form" model="ir.ui.view">
        <field name="name">product.template.form.inhiret</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="state"/>
                <field name="seat"/>
                <field name="registered_seat"/>
                <field name="remaining_course_seat"/>
            </xpath>
        </field>
    </record>
</odoo>